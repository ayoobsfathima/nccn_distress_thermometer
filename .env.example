# Copy this file to .env and fill in your own values.

# The long ID in your Google Sheet's URL, e.g.
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Name of the worksheet/tab to write responses into (created automatically if missing)
GOOGLE_WORKSHEET_NAME=Responses

# EITHER set this to the path of your downloaded service-account JSON key file...
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ...OR paste the JSON key contents directly here instead (useful for cloud
# deployments where you can't upload a file). Leave the FILE var above blank
# if you use this.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: require a password before the sidebar "Admin" panel is shown
ADMIN_PASSWORD=
